{
  "name": "kick-stream-overlay",
  "version": "1.0.78",
  "description": "Transparent always-on-top Kick chat + Streamlabs alert overlay for single-monitor streaming",
  "main": "main.js",
  "author": "Stouty",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "koffi": "2.16.3",
    "socket.io-client": "^2.5.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.stouty.kickoverlay",
    "productName": "Kick Stream Overlay",
    "icon": "build/icon.ico",
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "kick-chat.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!node_modules/koffi/build/koffi/{darwin_arm64,darwin_x64,freebsd_arm64,freebsd_ia32,freebsd_x64,linux_arm64,linux_armhf,linux_ia32,linux_loong64,linux_riscv64d,linux_x64,musl_arm64,musl_x64,openbsd_ia32,openbsd_x64,win32_arm64,win32_ia32}/**"
    ]
  }
}
